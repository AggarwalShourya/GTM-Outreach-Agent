# PS-3 outreach process — environment configuration
# Copy to `.env` next to the ps3 package (the server loads it at startup;
# real env vars always win). With NOTHING set, the process runs fully
# offline: seeded corpus + local deterministic embeddings + key-free Google
# News RSS for live companies.

# ---- Google embeddings (default real-embedding provider) ----
# Plain key = Generative Language endpoint, no OAuth. Model: text-embedding-004.
# GOOGLE_API_KEY=your-api-key
# PS3_EMBED_MODEL=text-embedding-004

# OR real Vertex AI (project-scoped):
# PS3_VERTEX=1
# PS3_VERTEX_PROJECT=your-gcp-project
# PS3_VERTEX_LOCATION=us-central1
# PS3_VERTEX_SA=/path/to/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---- Live web search for unseeded companies.
#  IMPORTANT — these are TWO DIFFERENT services with similar names:
#   SERPER_API_KEY  -> Google Serper (google.serper.dev)
#   SERPAPI_KEY     -> SerpApi (serpapi.com, the commonly-purchased one)
#  Use the key that matches where you bought it. If a keyed provider fails
#  (bad key / quota / geo-block / timeout) the system automatically falls
#  back to key-free Google News RSS and flags the run as "degraded" —
#  it never dies and never reports a failure as "no evidence found".
# TAVILY_API_KEY=
# SERPER_API_KEY=
# SERPAPI_KEY=
# BING_SEARCH_KEY=
# PS3_SEARCH_PROVIDER=auto    # auto | tavily | serper | serpapi | bing | rss | none

# ---- Toggles ----
# PS3_LIVE=1                  # master switch for live retrieval
# PS3_AUGMENT_SEEDED=0        # also pull live web docs for seeded demo companies
# PS3_RERANK=0                # optional LLM rerank of top-N fused chunks
# PS3_SEARCH_TOP=8
# PORT=8377
